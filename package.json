{
  "name": "forking-store",
  "version": "2.2.3",
  "description": "",
  "type": "module",
  "exports": {
    "import": "./dist/forking-store.js",
    "require": "./dist/forking-store.cjs",
    "types": "./dist/forking-store.d.ts"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "concurrently --group --prefix-colors auto \"npm:lint:*(!fix)\"",
    "lint:fix": "concurrently --group --prefix-colors auto \"npm:lint:*:fix\"",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --cache --fix",
    "lint:types": "tsc --noEmit",
    "lint:format": "prettier --cache --check .",
    "lint:format:fix": "prettier --cache --write .",
    "prepare": "npm run build",
    "release": "release-it",
    "test": "npm run build && node --test"
  },
  "author": "Sergey Andreev",
  "license": "MIT",
  "dependencies": {
    "rdflib": "^2.2.19"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "concurrently": "^8.2.1",
    "eslint": "^8.19.0",
    "eslint-plugin-n": "^16.1.0",
    "prettier": "^3.0.3",
    "release-it": "^16.1.5",
    "rollup": "^4.55.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "url": "https://github.com/redpencilio/forking-store.git"
  },
  "release-it": {
    "npm": {
      "publish": false
    }
  },
  "volta": {
    "node": "22.22.1"
  }
}
